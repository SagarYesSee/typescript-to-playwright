{
  "name": "typescript-to-playwright",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --config cloudflare/wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config cloudflare/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config cloudflare/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "wrangler": "4.158.0"
  }
}
